# LLM backend — choose ONE:
#
# A) Vertex AI (recommended in production; no API key, uses the runtime service
#    account's Application Default Credentials and GCP quota/credits):
# VERTEX_PROJECT=your-gcp-project-id
# VERTEX_LOCATION=us-central1
#
# B) AI Studio API key (simplest for local dev):
GEMINI_API_KEY=your-gemini-api-key-here

# Optional: override the model (default: gemini-2.5-flash)
# GEMINI_MODEL=gemini-2.5-flash
